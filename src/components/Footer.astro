---
interface Props {
  showDisclosure?: boolean;
}
const { showDisclosure = true } = Astro.props;
---
<footer class="footer" dir="rtl">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="copyright">© 2026 שוק מחנה יהודה · כל הזכויות שמורות.</p>
      {showDisclosure && <p class="independent">מדריך תיירות עצמאי למבקרים בירושלים, ללא קשר להנהלת השוק או לגוף רשמי.</p>}
    </div>
    <nav class="footer-legal" aria-label="מידע משפטי">
      <a href="/#sources">מקורות מידע</a>
      <a href="/#photo-credits">מקורות צילום</a>
      <a href="/privacy/">מדיניות פרטיות</a>
      <a href="/terms/">תנאי שימוש</a>
      <a href="/cookies/">הגדרות Cookie</a>
    </nav>
  </div>
</footer>
<style>
  .footer { background:#1d1813; color:#eee4d5; padding:2.2rem 0; }
  .footer-inner { display:flex; justify-content:space-between; align-items:start; gap:1.5rem 2.5rem; flex-wrap:wrap; }
  .footer-brand { max-width:40rem; }
  .copyright { font-weight:700; color:#fff9ee; margin:0; }
  .independent { color:#cfc3b4; font-size:.85rem; line-height:1.7; margin:.5rem 0 0; }
  .footer-legal { display:flex; flex-wrap:wrap; gap:.6rem 1.2rem; align-items:center; }
  .footer-legal a { color:#eee4d5; text-decoration:none; font-size:.9rem; }
  .footer-legal a:hover { color:#d9a03b; text-decoration:underline; }
  @media(max-width:720px) { .footer-inner { flex-direction:column; } .footer-legal { gap:.65rem 1rem; } }
</style>
