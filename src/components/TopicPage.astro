---
import BaseLayout from '../layouts/BaseLayout.astro';
import { topicPath, groupLabel, resolveRelated } from '../lib/topics';
import type { Topic } from '../data/topics';
import { getImage } from 'astro:assets';
import marketOriginal from '../assets/market-2018.jpg';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;

const site = Astro.site!.origin;
const hero = await getImage({ src: marketOriginal, width: 1200, format: 'webp', quality: 82 });
const absUrl = site + topicPath(topic);
const groupHeb = groupLabel(topic.group);
const related = resolveRelated(topic.related);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'שוק מחנה יהודה',
      item: site + '/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: groupHeb,
      item: site + '/#guides'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: topic.h1,
      item: absUrl
    }
  ]
};

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: topic.h1,
  url: absUrl,
  inLanguage: 'he',
  description: topic.description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'שוק מחנה יהודה',
    url: site + '/'
  }
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a
    }
  }))
};

const jsonLd = [webPage, breadcrumb, faqPage];
const textParts = (text: string) => text.split(/(\d{1,2}:\d{2}(?:[–־-]\d{1,2}:\d{2})?|\d+\.\d+(?:,\s*\d+\.\d+)?)/g).map((value, i) => ({ value, numeric: i % 2 === 1 }));
---

<BaseLayout title={topic.title} description={topic.description} jsonLd={jsonLd}>
  <article class="container topic-page" dir="rtl">
    <nav class="breadcrumb" aria-label="פירורי לחם">
      <a href="/">שוק מחנה יהודה</a>
      <span aria-hidden="true">›</span>
      <a href="/#guides">{groupHeb}</a>
      <span aria-hidden="true">›</span>
      <span>{topic.h1}</span>
    </nav>

    <header class="topic-hero">
      <div class="hero-copy">
      <p class="kicker">{topic.kicker}</p>
      <h1>{topic.h1}</h1>
      <p class="lead">{textParts(topic.lead).map(p => p.numeric ? <bdi dir="ltr">{p.value}</bdi> : p.value)}</p>
      <p class="updated-note">עודכן לאחרונה: {topic.updated}</p>
      </div>
      <figure class="hero-photo">
        <img src={hero.src} width={hero.attributes.width} height={hero.attributes.height} alt="מעבר מקורה בשוק מחנה יהודה, תצלום מ־2018" />
        <figcaption>Emilio García · 2018 · <a href="/#photo-credits">מקור ורישיון CC BY-SA 2.0</a></figcaption>
      </figure>
    </header>

    <nav class="section-nav" aria-label="בעמוד זה">
      {topic.sections.map(s => <a href={`#${s.id}`}>{s.heading}</a>)}
      <a href="#faq-title">שאלות נפוצות</a>
    </nav>

    <div class="topic-sections">
      {
        topic.sections.map((s) => (
          <section id={s.id} class="topic-section">
            <h2>{s.heading}</h2>
            {s.paragraphs.map((p) => (
              <p>{textParts(p).map(part => part.numeric ? <bdi dir="ltr">{part.value}</bdi> : part.value)}</p>
            ))}
            {s.callout && <p class="callout">{s.callout}</p>}
          </section>
        ))
      }
    </div>

    {topic.maps && topic.maps.length > 0 && (
      <section class="topic-maps" aria-labelledby="maps-title">
        <h2 id="maps-title">נקודות להתמצאות במפה</h2>
        <p>בחרו יעד ופתחו ב־Google Maps לתכנון הדרך מנקודת המוצא שלכם.</p>
        <ul>{topic.maps.map(m => <li><a href={m.url} target="_blank" rel="noopener noreferrer">{m.label} ↗</a></li>)}</ul>
      </section>
    )}

    {
      topic.faqs.length > 0 && (
        <section class="topic-faq" aria-labelledby="faq-title">
          <h2 id="faq-title">שאלות נפוצות</h2>
          <div class="faq-list">
            {topic.faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <div class="faq-answer">{textParts(f.a).map(p => p.numeric ? <bdi dir="ltr">{p.value}</bdi> : p.value)}</div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="topic-related" aria-labelledby="related-title">
          <h2 id="related-title">עמודים קשורים</h2>
          <ul class="related-list">
            {related.map((r) => (
              <li>
                <a href={topicPath(r)}>
                  <span class="related-kicker">{groupLabel(r.group)}</span>
                  <span class="related-title">{r.h1}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      topic.sources && topic.sources.length > 0 && (
        <aside class="topic-sources" aria-labelledby="topic-sources-title">
          <h2 id="topic-sources-title">מקורות לקריאה נוספת</h2>
          <ul>
            {topic.sources.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .topic-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted, #6b6256);
    margin-bottom: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .kicker {
    color: var(--accent, #b4690e);
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0 0 0.4rem;
  }
  .topic-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }
  .lead {
    font-size: 1.1rem;
    color: #e9dfd0;
    margin: 0 0 0.75rem;
  }
  .updated-note {
    font-size: 0.82rem;
    color: #e9dfd0;
    background: #2a241e;
    border-inline-start: 4px solid var(--accent, #b4690e);
    padding: 0.5rem 0.75rem;
    border-radius: 0.35rem;
  }
  .topic-section {
    scroll-margin-top: 6rem;
    margin-top: 1.2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .topic-section h2 {
    font-size: 1.35rem;
    margin: 0 0 0.6rem;
  }
  .topic-section p {
    margin: 0 0 0.8rem;
    line-height: 1.7;
  }
  .callout {
    background: #f6f1e7;
    border-inline-start: 4px solid var(--accent, #b4690e);
    padding: 0.6rem 0.85rem;
    border-radius: 0.35rem;
    font-size: 0.95rem;
  }
  .topic-faq {
    margin-top: 2.5rem;
  }
  .topic-faq h2,
  .topic-related h2 {
    font-size: 1.35rem;
    margin: 0 0 0.8rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .faq-item {
    border: 1px solid #e3d9c8;
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    background: #fffdf8;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
  }
  .faq-answer {
    margin-top: 0.5rem;
    line-height: 1.7;
  }
  .topic-related {
    margin-top: 2.5rem;
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .related-list a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid #e3d9c8;
    border-radius: 0.5rem;
    background: #fffdf8;
    text-decoration: none;
    color: inherit;
  }
  .related-list a:hover {
    border-color: var(--accent, #b4690e);
  }
  .related-kicker {
    font-size: 0.78rem;
    color: var(--accent, #b4690e);
    font-weight: 700;
  }
  .related-title {
    font-size: 1rem;
    font-weight: 600;
  }
  .topic-sources { margin-top:2.5rem; border-top:1px solid #e3d9c8; padding-top:1.25rem; }
  .topic-sources h2 { font-size:1.15rem; margin:0 0 .6rem; }
  .topic-sources ul { margin:0; padding-inline-start:1.25rem; line-height:1.8; }
  .topic-sources a { color:#785019; text-underline-offset:3px; }
  .topic-hero { display:grid; grid-template-columns:1.2fr 1fr; overflow:hidden; border-radius:30px; background:var(--ink); color:var(--paper); }
  .hero-copy { padding:clamp(1.5rem, 4vw, 3rem); }
  .kicker { color:#e4b453; }
  .hero-photo { margin:0; display:flex; flex-direction:column; min-width:0; }
  .hero-photo img { flex:1; height:100%; min-height:320px; object-fit:cover; }
  .hero-photo figcaption { color:#e9dfd0; padding:.6rem .9rem; font-size:.72rem; }
  .section-nav { display:flex; flex-wrap:wrap; gap:.6rem; padding:1.4rem 0; }
  .section-nav a { border:1px solid var(--line); border-radius:999px; padding:.5rem .85rem; text-decoration:none; background:var(--paper); font-size:.85rem; }
  .section-nav a:hover { background:var(--stone-deep); }
  .topic-sections, .topic-faq, .topic-related, .topic-sources, .topic-maps { max-width:52rem; margin-inline:auto; }
  .topic-maps { margin-top:2rem; padding:1.5rem; border-radius:22px; background:var(--stone-deep); }
  .topic-maps h2 { margin-top:0; font-size:1.35rem; }
  .topic-maps ul { display:flex; flex-wrap:wrap; gap:.7rem; list-style:none; padding:0; }
  .topic-maps a { display:block; background:var(--ink); color:var(--paper); padding:.65rem .9rem; border-radius:999px; text-decoration:none; }
  #faq-title { scroll-margin-top:6rem; }
  @media(max-width:760px) { .topic-hero { grid-template-columns:1fr; border-radius:22px; } .hero-photo img { height:220px; min-height:0; } .related-list { grid-template-columns:1fr; } }
</style>
