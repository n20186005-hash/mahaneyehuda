---
// תחזית מזג אוויר עבור שוק מחנה יהודה.
// הנתונים נטענים בצד השרת בזמן הבנייה (Static) ומוטמעים ישירות בתוך דף התוצאה,
// כך שהמבקר מקבל תחזית עדכנית מבלי תלות בטעינת קוד בדפדפן.
// הממשק לא רק מציג מספרים — הוא מתרגם אותם להמלצות פעולה קצרות וברורות למבקר.
import { ATTRACTION } from '../data/market';

const LAT = ATTRACTION.latitude;
const LON = ATTRACTION.longitude;

type Desc = { label: string; icon: string };
const WMO: Record<number, Desc> = {
  0: { label: 'בהיר', icon: '☀️' },
  1: { label: 'בהיר עם מעט עננים', icon: '🌤️' },
  2: { label: 'מעונן חלקית', icon: '⛅' },
  3: { label: 'מעונן', icon: '☁️' },
  45: { label: 'ערפל', icon: '🌫️' },
  48: { label: 'ערפל קפוא', icon: '🌫️' },
  51: { label: 'גשם קל', icon: '🌦️' },
  53: { label: 'גשם קל', icon: '🌦️' },
  55: { label: 'גשם קל', icon: '🌦️' },
  56: { label: 'גשם קפוא', icon: '🌧️' },
  57: { label: 'גשם קפוא', icon: '🌧️' },
  61: { label: 'גשם', icon: '🌧️' },
  63: { label: 'גשם', icon: '🌧️' },
  65: { label: 'גשם חזק', icon: '🌧️' },
  66: { label: 'גשם קפוא', icon: '🌧️' },
  67: { label: 'גשם קפוא', icon: '🌧️' },
  71: { label: 'שלג', icon: '❄️' },
  73: { label: 'שלג', icon: '❄️' },
  75: { label: 'שלג', icon: '❄️' },
  77: { label: 'גרגירי שלג', icon: '🌨️' },
  80: { label: 'גשם מקומי', icon: '🌦️' },
  81: { label: 'גשם', icon: '🌧️' },
  82: { label: 'גשם עז', icon: '⛈️' },
  85: { label: 'שלג מקומי', icon: '🌨️' },
  86: { label: 'שלג מקומי', icon: '🌨️' },
  95: { label: 'סופה עם ברקים', icon: '⛈️' },
  96: { label: 'סופה עם ברד', icon: '⛈️' },
  99: { label: 'סופה עם ברד', icon: '⛈️' }
};
const describe = (code: number): Desc => WMO[code] ?? { label: 'מזג אוויר מעורב', icon: '🌡️' };

interface ForecastDay {
  weekday: string;
  code: number;
  tmax: number;
  tmin: number;
  precipSum: number;
  precipProb: number;
}
interface Cached {
  current?: any;
  days?: ForecastDay[];
  today?: ForecastDay | undefined;
  error?: boolean;
}

const cacheKey = 'mahanehuda-weather';
const store = globalThis as any;
if (!store[cacheKey]) {
  try {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 10000);
    const url =
      `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}` +
      `&current=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,wind_speed_10m,is_day,uv_index` +
      `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,sunrise,sunset` +
      `&timezone=auto&forecast_days=7&wind_speed_unit=kmh`;
    const res = await fetch(url, {
      signal: controller.signal,
      headers: { 'User-Agent': 'mahaneyehuda-org/1.0' }
    });
    clearTimeout(timer);
    if (!res.ok) throw new Error('weather http ' + res.status);
    const json = await res.json();
    const d = json.daily as any;
    const fmt = new Intl.DateTimeFormat('he-IL', { weekday: 'long' });
    const days: ForecastDay[] = d.time.map((t: string, i: number) => ({
      weekday: fmt.format(new Date(t + 'T00:00:00')),
      code: d.weather_code[i],
      tmax: Math.round(d.temperature_2m_max[i]),
      tmin: Math.round(d.temperature_2m_min[i]),
      precipSum: d.precipitation_sum[i],
      precipProb: d.precipitation_probability_max[i]
    }));
    store[cacheKey] = { current: json.current, days, today: days[0] } as Cached;
  } catch {
    store[cacheKey] = { error: true } as Cached;
  }
}

const cached = store[cacheKey] as Cached;
const hasError = !!cached.error || !cached.current;
const today = cached.today;
const days = cached.days ?? [];
const current = cached.current;

// ---- מנוע המלצות: מתרגם נתונים להמלצות פעולה ----
type Advice = { travel: string[]; activity: string[]; items: string[]; risk: string[] };
let advice: Advice = { travel: [], activity: [], items: [], risk: [] };

if (today && current) {
  const code = today.code;
  const ccode = current.weather_code;
  const tmax = today.tmax;
  const tmin = today.tmin;
  const precipProb = today.precipProb;
  const precipSum = today.precipSum;
  const wind = Math.round(current.wind_speed_10m ?? 0);
  const uv = current.uv_index ?? 0;

  const isThunder = [95, 96, 99].includes(code);
  const isHeavyRain = [65, 82].includes(code) || precipSum >= 10;
  const isRain = [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code);
  const isLightRain = [51, 53, 55, 56, 57, 80].includes(code);
  const isFog = [45, 48].includes(code);
  const isClear = [0, 1].includes(code);
  const isCloudy = code === 3;
  const isPartly = code === 2;
  const windLevel = wind >= 39 ? 3 : wind >= 29 ? 2 : wind >= 12 ? 1 : 0;
  const sunStrong = (isClear || isPartly) && (tmax >= 28 || uv >= 5);
  const diff = tmax - tmin;

  // 1) התארגנות ולבוש
  if (tmax >= 32) advice.travel.push('חם יחסית — עדיף לבקר מוקדם בבוקר או לקראת ערב, והימנעו מחשיפה ארוכה לשמש בשיא היום.');
  if (tmax <= 10) advice.travel.push('קריר — כדאי מעיל חם; אם קר מאוד, גם כפפות.');
  if (tmin <= 5) advice.travel.push('בלילה הטמפרטורה יורדת הרבה — היערכו בהתאם אם נשארים עד הערב.');
  if (diff > 8) advice.travel.push('הפרשי טמפרטורה בין יום ללילה גדולים — שווה לקחת שכבת לבוש נוספת.');
  if (precipProb >= 60) advice.travel.push(`סיכוי גבוה לגשם (כ־${precipProb}%) — רצוי להצטייד במטריה או מעיל גשם.`);
  else if (isRain) advice.travel.push('יורד או עשוי לרדת גשם — המעברים עלולים להיות רטובים ומחליקים.');
  if (isClear) advice.travel.push('מזג אוויר נאה — מתאים לטיול רגלי ולביקור בשוק.');
  if (isCloudy) advice.travel.push('עננות — אור רך ונוח לטיול ממושך ולצילום.');
  if (isFog) advice.travel.push('ערפל — הראות מוגבלת בהליכה.');
  if (windLevel >= 2) advice.travel.push(`רוח ערה (${wind} קמ״ש) — כובע עלול להיעלף; עדיף לא להשתמש במטריה ארוכה.`);
  if (sunStrong) advice.travel.push('שמש חזקה — מומלץ להגן על העור ועל העיניים.');

  // 2) איך לתכנן את הביקור
  if (tmax >= 32) advice.activity.push('קצרו שהייה בחוץ; נצלו צל, דוכני פנים ובתי קפה.');
  if (precipProb >= 60 || isRain) advice.activity.push('עדיפו את המעברים המקורים ואת הדוכנים שבפנים; החוויה הפתוחה פחות נוחה בגשם.');
  if (isHeavyRain) advice.activity.push('מומלץ להגביל שהייה בחוץ ולהסתובב בעיקר באזורים מקורים; פעילות ערב עלולה להיפגע.');
  if (isThunder) advice.activity.push('המתינו במקום מקורה; הימנעו מאזורים פתוחים וממבני מתכת בזמן סופה.');
  if (isClear) advice.activity.push('זמן טוב לצילום התריסים המצוירים ולשוטט בנחלאות.');
  if (isCloudy) advice.activity.push('אור נוח לצילום ולקניות של אחר הצהריים.');
  if (isFog) advice.activity.push('הליכה זהירה; תצפיות רחוקות פחות ברורות.');
  if (tmax <= 10) advice.activity.push('הדוכנים המקורים נעימים יותר כשקר בחוץ.');
  if (windLevel >= 2 && !isThunder) advice.activity.push('בימים עם רוח, דוכני רחוב פתוחים עשויים להיות פחות נוחים — העדיפו פנים.');

  // 3) מה כדאי לקחת (דינמי — רק מה רלוונטי)
  if (precipProb >= 60 || isRain) advice.items.push('☂️ מטריה / מעיל גשם');
  if (isHeavyRain) advice.items.push('🧥 מעיל גשם (לא מטריה ארוכה ברוח)');
  if (tmax >= 32 || sunStrong) {
    advice.items.push('🧴 קרם הגנה', '🕶️ משקפי שמש', '🧢 כובע', '💧 בקבוק מים');
  }
  if (tmax <= 10) advice.items.push('🧥 מעיל חם', '🧣 צעיף');
  if (diff > 8) advice.items.push('🧥 שכבת לבוש נוספת');
  if (windLevel >= 2) advice.items.push('🪢 להימנע ממטריה ארוכה (רוח)');
  if (isFog) advice.items.push('😷 מסכה (ראות לקויה)');

  // 4) התראות סיכון — רק אם יש סיבה
  if (isThunder) advice.risk.push('⚠️ סופת רעמים — סכנת ברקים. אל תשהו בשטח פתוח או ליד מתכת; המתינו במקום מקורה.');
  if (isHeavyRain) advice.risk.push('⚠️ גשם חזק — הימנעו מהצטברות מים וממעברים מוצפים.');
  if (isFog) advice.risk.push('⚠️ ערפל — הראות לקויה, היזהרו בהליכה.');
  if (windLevel >= 3) advice.risk.push('⚠️ רוח חזקה — הימנעו משלטים ומקורות לא יציבים.');
}
const hasAdvice = advice.travel.length || advice.activity.length || advice.items.length;
---

<section class="section weather" id="weather">
  <div class="container">
    <p class="eyebrow">מזג אוויר לתכנון הביקור</p>
    <h2 class="section-title">להביא מטריה, או סתם כובע?</h2>

    {
      hasError ? (
        <p class="lede weather-fallback">
          התחזית אינה זמינה כרגע. לתכנון מדויק מומלץ לבדוק תחזית מזג אוויר עדכנית לירושלים לפני היציאה מהבית,
          ולהיערך בהתאם לעונה: מים וצל בקיץ, ומטריה או מעיל גשם בחורף ובשבועות הגשם.
        </p>
      ) : (
        <>
          {advice.risk.length > 0 && (
            <div class="risk" role="alert">
              {advice.risk.map((r) => <p>{r}</p>)}
            </div>
          )}

          <div class="weather-layout">
            <div class="now-card">
              <div class="now-temp">
                <span class="now-icon">{describe(current.weather_code).icon}</span>
                <strong>{Math.round(current.temperature_2m)}°</strong>
                <span class="now-unit">צלזיוס</span>
              </div>
              <p class="now-cond">{describe(current.weather_code).label}</p>
              {today && (
                <p class="now-range">היום {today.tmin}°–{today.tmax}°</p>
              )}
              <ul class="now-meta">
                {current.apparent_temperature != null && (
                  <li>מרגיש כמו {Math.round(current.apparent_temperature)}°</li>
                )}
                {today && <li>סיכוי גשם {today.precipProb}%</li>}
                {current.wind_speed_10m != null && <li>רוח {Math.round(current.wind_speed_10m)} קמ״ש</li>}
                {current.uv_index != null && current.uv_index >= 3 && <li>קרינת שמש {Math.round(current.uv_index)}</li>}
              </ul>
            </div>

            {hasAdvice && (
              <div class="advice-grid">
                <div class="panel">
                  <h3 class="panel-title">התארגנות ולבוש</h3>
                  <ul>{advice.travel.map((s) => <li>{s}</li>)}</ul>
                </div>
                <div class="panel">
                  <h3 class="panel-title">איך לתכנן את הביקור</h3>
                  <ul>{advice.activity.map((s) => <li>{s}</li>)}</ul>
                </div>
                <div class="panel items">
                  <h3 class="panel-title">מה כדאי לקחת</h3>
                  <ul class="chips">{advice.items.map((s) => <li>{s}</li>)}</ul>
                </div>
              </div>
            )}
          </div>

          <div class="forecast">
            <p class="forecast-title">תחזית לימים הקרובים</p>
            <ul class="forecast-list">
              {days.map((day, i) => (
                <li class={i === 0 ? 'today' : ''}>
                  <span class="f-day">{i === 0 ? 'היום' : day.weekday}</span>
                  <span class="f-icon">{describe(day.code).icon}</span>
                  <span class="f-cond">{describe(day.code).label}</span>
                  <span class="f-temp">{day.tmin}° / {day.tmax}°</span>
                  <span class="f-rain">גשם {day.precipProb}%</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
    <p class="notice">התחזית מתעדכנת בעת בניית הדף ומשקפת הערכה לזמן הקרוב. בימים גשומים או חמים במיוחד כדאי לאמת שוב לפני היציאה.</p>
  </div>
</section>

<style>
  .weather { background:#eef3f4; }
  .risk { background:#fdecea; border:1px solid #f3b1aa; border-right:5px solid #c0392b; border-radius:16px; padding:1rem 1.2rem; margin-bottom:1.4rem; color:#7d241c; }
  .risk p { margin:.2rem 0; font-weight:800; }
  .weather-layout { display:grid; grid-template-columns:.8fr 1.2fr; gap:1.5rem; align-items:start; }
  .now-card { background:#fff; border-radius:24px; padding:1.6rem; box-shadow:0 16px 40px rgba(29,31,36,.08); }
  .now-temp { display:flex; align-items:baseline; gap:.5rem; }
  .now-icon { font-size:2.6rem; }
  .now-temp strong { font-size:3.4rem; line-height:1; }
  .now-unit { color:#6b7780; font-size:.9rem; }
  .now-cond { margin:.4rem 0 .2rem; font-weight:800; font-size:1.2rem; }
  .now-range { margin:0 0 1rem; color:#566069; font-weight:700; }
  .now-meta { list-style:none; padding:0; margin:0; display:grid; gap:.3rem; color:#566069; font-size:.92rem; }
  .advice-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .advice-grid .items { grid-column:1 / -1; }
  .panel { background:#fff; border-radius:20px; padding:1.2rem 1.3rem; box-shadow:0 10px 30px rgba(29,31,36,.06); }
  .panel-title { margin:0 0 .6rem; font-size:1.05rem; color:#1d4e6b; }
  .panel ul { list-style:none; margin:0; padding:0; display:grid; gap:.55rem; }
  .panel li { position:relative; padding-right:1.2rem; color:#3a434b; font-size:.94rem; line-height:1.45; }
  .panel li::before { content:'✔'; position:absolute; right:0; color:#1f7a45; font-weight:900; }
  .panel.items .chips { display:flex; flex-wrap:wrap; gap:.5rem; }
  .panel.items li { padding-right:0; }
  .panel.items li::before { content:''; }
  .panel.items .chips li { background:#eef5f8; border:1px solid #cfe3ec; border-radius:999px; padding:.35rem .8rem; font-weight:700; color:#235a73; }
  .forecast { margin-top:1.5rem; }
  .forecast-title { margin:0 0 .8rem; font-weight:800; color:#3a434b; }
  .forecast-list { list-style:none; margin:0; padding:0; display:grid; gap:.5rem; }
  .forecast-list li { display:grid; grid-template-columns:64px 34px 1fr auto auto; gap:.8rem; align-items:center; background:#fff; border-radius:14px; padding:.7rem .9rem; box-shadow:0 8px 22px rgba(29,31,36,.05); }
  .forecast-list li.today { outline:2px solid #a53b35; }
  .f-day { font-weight:800; }
  .f-icon { font-size:1.3rem; text-align:center; }
  .f-cond { color:#4a535b; }
  .f-temp { font-variant-numeric:tabular-nums; font-weight:700; }
  .f-rain { font-size:.82rem; color:#5b6770; }
  .weather-fallback { max-width:62ch; }
  @media(max-width:820px){
    .weather-layout{grid-template-columns:1fr}
    .advice-grid{grid-template-columns:1fr}
    .forecast-list li{grid-template-columns:56px 30px 1fr auto} .f-rain{display:none}
  }
</style>
