---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { ATTRACTION, SITE_NAME, withSiteName, SITE_URL } from '../data/market';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = '/og-card.png', noindex = false } = Astro.props;
// canonical תמיד מוחלט ומפנה ל-HTTPS; אם Astro.site אינו מוגדר בבנייה, נופלים ל-SITE_URL.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const pageTitle = withSiteName(title);
const ogImageAlt = `סמל קשת ורימון של מדריך ${ATTRACTION.nameHe}; איור, לא תצלום`;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d1813" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="he" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={ATTRACTION.shortNameHe} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="geo.region" content="IL" />
    <meta name="geo.placename" content={`${ATTRACTION.cityHe}, ${ATTRACTION.countryHe}`} />
    <meta name="ICBM" content={`${ATTRACTION.latitude}, ${ATTRACTION.longitude}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">דילוג לתוכן</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
    <aside id="cookie-banner" data-open="false" class="cookie-banner" aria-label="בחירת ניתוח">
      <p>ניתוח Google Analytics כבוי עד להסכמה. מפת Google נטענת בנפרד.</p>
      <button id="cookies-essential" type="button">דחיית ניתוח</button>
      <button id="cookies-accept" type="button">הסכמה לניתוח</button>
      <a href="/cookies/">הגדרות</a><p id="cookie-banner-status" role="status"></p>
    </aside>
    <script src="/consent.js" is:inline defer></script>
    <script src="/retire-offline.js" is:inline defer></script>
  </body>
</html>
