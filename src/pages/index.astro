---
import BaseLayout from '../layouts/BaseLayout.astro';
import Weather from '../components/Weather.astro';
import { ATTRACTION, SITE_URL } from '../data/market';

const siteUrl = Astro.site ? new URL('/', Astro.site).href : SITE_URL;
const heroImage = new URL('/og-card.png', siteUrl).href;
import { getImage } from 'astro:assets';
import heroOriginal from '../assets/market-2018.jpg';
const heroPhoto = (await getImage({src:heroOriginal,width:1920,format:'webp',quality:82})).src;

const marketFullName = `${ATTRACTION.nameHe} (${ATTRACTION.nameEn})`;
const addressLineHe = `${ATTRACTION.streetAddressHe}, ${ATTRACTION.cityHe}`;
const ratingLabel = `${ATTRACTION.ratingValue} / 5`;
const ratingCountLabel = ATTRACTION.ratingCount.toLocaleString('he-IL');

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}#attraction`,
  name: ATTRACTION.nameHe,
  alternateName: [...ATTRACTION.alternateNames],
  description: `מדריך מבקרים מקיף ל${marketFullName} ב${ATTRACTION.cityHe}, ${ATTRACTION.regionHe}, ${ATTRACTION.countryHe}: היסטוריה, מיקום, שעות פעילות, הגעה, נגישות ושאלות נפוצות.`,
  url: siteUrl,
  logo: new URL('/logo.svg', siteUrl).href,
  image: [heroImage, new URL(heroPhoto, siteUrl).href],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${ATTRACTION.streetAddressHe} (${ATTRACTION.streetAddressEn})`,
    addressLocality: ATTRACTION.cityHe,
    addressRegion: ATTRACTION.regionHe,
    addressCountry: ATTRACTION.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: ATTRACTION.latitude,
    longitude: ATTRACTION.longitude
  },
  hasMap: ATTRACTION.mapsShareUrl,
  sameAs: [...ATTRACTION.sameAs]

};

const faqs = [
  ['איפה נמצא שוק מחנה יהודה — Mahaneh Yehudah Market?', `השוק נמצא ב${ATTRACTION.cityHe}, ${ATTRACTION.regionHe}, ${ATTRACTION.countryHe}: ${ATTRACTION.streetAddressHe} (${ATTRACTION.streetAddressEn}). הסיכה במפה היא נקודת ייחוס למקום, לא כניסה או מסלול נגיש מאומת; השתמשו בקישור המפה ובדקו את הכניסה הרצויה.`],
  ['כמה זמן כדאי להקדיש לביקור בשוק מחנה יהודה?', `דוגמת תכנון היא כשעה וחצי עד שלוש שעות, לא זמן השלמה שנמדד. חצי יום עם נחלאות או העיר העתיקה הוא רעיון מותנה: בדקו פתיחה, מסלול נוכחי והקצב האישי לפני שילוב מקומות נפרדים.`],
  ['האם הכניסה לשוק מחנה יהודה כרוכה בתשלום?', 'השוק הוא מרחב רחובות ועסקים. תנאי הכניסה והוצאות הביקור הנוכחיים לא אומתו בנפרד; מזון, קניות ופעילות פרטית תלויים בספק. בדקו את התנאים והמחיר לפני הזמנה.'],
  ['מתי כדאי להגיע?', 'לביקור נוח יחסית כדאי לבחור ביום חול בשעות הבוקר המאוחרות או בצהריים. שישי בבוקר מעניק אווירת קניות חזקה לפני שבת, אך גם צפוף יותר. שעות הפעילות עשויות להשתנות בערבי חג ובחגים.'],
  ['האם השוק פתוח בשבת?', 'ברשומת Google Maps שנבדקה ב־20 באוקטובר 2026 שבת מסומנת כסגורה. זהו רישום השוק, לא לוח של כל דוכן, בר או חג; אשרו את יום הביקור עם העסק הרצוי.'],
  ['יש שירותים ציבוריים?', 'באתר המידע המסחרי של השוק, FAQ שנבדק ב־20 באוקטובר 2026, מפורטים שלושה מוקדים: באזור רחוב עץ חיים ליד הכניסה מאגריפס (נשים), ברחוב השזיף פינת מחנה יהודה (נשים וגברים), וברחוב התפוח פינת מחנה יהודה (גברים). חלוקת תאי נשים וגברים אינה זהה בכל מוקד, לכן בדקו שילוט ומצב פתיחה במקום; זמינות ונגישות היום לא אומתו.'],
  ['האם השוק נגיש לכיסאות גלגלים ולעגלות?', 'ברשומת המפה מופיע סימון כניסה נגישה, אך זו אינה בדיקת מסלול מלא. אשרו מראש רוחב מעבר, ספים, שיפועים, שירותים וכניסה לעסק הרצוי; אין כאן מסלול מאומת לכיסא גלגלים.'],
  ['איך מגיעים מנתב״ג?', 'אפשרות לתכנון היא רכבת לירושלים–יצחק נבון והמשך לתחנת מחנה יהודה, רק אם מפעילי הרכבת והרכבת הקלה מאשרים את השירות והחיבור בתאריך הרצוי. רשות שדות התעופה מפרטת גם מוניות מורשות; בדקו הסדרים ומחיר לפני הנסיעה.'],
  ['אפשר להגיע ברכב פרטי?', 'אפשר לתכנן הגעה ברכב לאחר בדיקת הסדרי התנועה והחניה ביום הנסיעה. אתר השוק מזכיר חניונים בתשלום; אשרו מפעיל, מחיר וגישה והשוו למסלול תחבורה שפועל בתאריך הרצוי.'],
  ['האם כל האוכל בשוק כשר?', 'לא ניתן להניח שכל עסק פועל תחת אותה השגחה. מי שנדרש לכשרות מסוימת צריך לבדוק תעודה תקפה והיקף השגחה בכל נקודת מכירה בנפרד.'],
  ['מתי שוק מחנה יהודה נסגר?', 'לפי רשומת Google Maps מ־20 באוקטובר 2026: א׳–ה׳ 08:00–19:00, ו׳ 08:00–15:00, שבת סגור. אלה שעות הרשומה בלבד, לא אישור לכל דוכן, פעילות ערב או חג. אתר השוק מזכיר חריגי שבת וחג; בדקו את העסק והתאריך הרצויים.'],
  ['האם שעות השוק בחג או ביום העצמאות זהות ליום חול?', 'אין להסיק זאת מלוח שבועי רגיל. אתר המידע של השוק מזכיר חריגי חגים; לא אומתו כאן שעות לתאריך חג מסוים. בדקו את העסק הרצוי, הודעות עירייה ולוחות מפעילי התחבורה לתאריך הנסיעה לפני היציאה.'],
  ['מתי הוקם שוק מחנה יהודה?', 'סקירת ההיסטוריה באתר השוק מתארת שוק שהתפתח בסוף המאה ה־19 ולא אירוע פתיחה יחיד. חנויות קבע נוספו בשלבים; אזור נוסף, המזוהה עם סוחרים עיראקים, נפתח ב־1931. יש להבחין בין תחילת המסחר לבין הרחבות מאוחרות.'],
  ['איפה חניון שוק מחנה יהודה?', 'לא אומת חניון מסוים או מקום פנוי. בדקו מול מפעיל החניון את המיקום, שעות הפתיחה, תעריף, גובה וגישה למסלול המבוקש, ופעלו לפי השילוט וההסדרים ביום ההגעה.']
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q,a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---
<BaseLayout title={`שוק מחנה יהודה, ירושלים — מדריך תיירים`} description={`מדריך תיירים עצמאי וללא מטרות רווח לשוק מחנה יהודה (Mahaneh Yehudah Market) בירושלים, מחוז ירושלים, ישראל: היסטוריה, שעות רשומה, קישור לתחזית רשמית, הגעה מנתב״ג, תחבורה ציבורית, נגישות, אוכל, חניה, אתרים סמוכים ושאלות נפוצות.`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(attractionSchema)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>

  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src={heroPhoto} width="1920" height="1280" alt={`${ATTRACTION.nameHe} (${ATTRACTION.nameEn}) — המראה המרכזי של השוק ב${ATTRACTION.cityHe}, ${ATTRACTION.countryHe}`} fetchpriority="high" />
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="market-stamp">ירושלים · מרכז העיר</span>
        <p class="eyebrow light">שוק, שכונה וסיפור עירוני</p>
        <h1>שוק<br />מחנה יהודה<span class="h1-entity">{ATTRACTION.nameEn} · {ATTRACTION.cityHe}, {ATTRACTION.countryHe}</span></h1>
        <p class="hero-lede">יותר ממקום לקנות בו ירקות: מרחב ירושלמי שנולד מן היציאה מחוץ לחומות, התמסד כשוק עירוני, והפך למפגש בין מזון, מסחר, זיכרון, אמנות רחוב וחיי ערב.</p>
        <div class="hero-actions">
          <a class="primary" href="#visit">לתכנון הביקור</a>
          <a class="secondary" href="#history">לסיפור ההיסטורי</a>
        </div>
      </div>
      <aside class="quick" aria-label="מידע מהיר">
        <div><strong>בדיקה מראש</strong><span>תנאי כניסה ועלויות</span></div>
        <div><strong>א׳–ה׳</strong><span>08:00–19:00</span></div>
        <div><strong>ו׳</strong><span>08:00–15:00</span></div>
        <div><strong>שבת</strong><span>סגור ברשומה</span></div>
        <div><strong>{ratingLabel}</strong><span>{ratingCountLabel} ביקורות</span></div>
        <p class="rating-note">רשומת {ATTRACTION.ratingSourceNote} נבדקה {ATTRACTION.ratingSyncedAt}; שעות ודירוג צד שלישי, לא של כל עסק או חג.</p>
      </aside>
    </div>
    <p class="photo-credit">צילום: Emilio García · 10.8.2018 · <a href="#photo-credits">מקור, רישיון ושינויים</a></p>
  </section>

  <section class="section intro" id="overview">
    <div class="container section-grid">
      <div>
        <p class="eyebrow">במבט אחד</p>
        <h2 class="section-title">השוק שמספר את ירושלים דרך הרחוב<span class="section-en">About {ATTRACTION.nameEn}</span></h2>
      </div>
      <div>
        <nav class="geo-crumbs" aria-label="היררכיה גאוגרפית">
          <span>{ATTRACTION.nameHe}</span><span aria-hidden="true">›</span><span>{ATTRACTION.cityHe}</span><span aria-hidden="true">›</span><span>{ATTRACTION.regionHe}</span><span aria-hidden="true">›</span><span>{ATTRACTION.countryHe}</span>
        </nav>
        <p class="entity-bind">ברוכים הבאים ל<strong>{ATTRACTION.nameHe}</strong>, המוכר בעולם כ<strong>{ATTRACTION.nameEn}</strong> — השוק העירוני המרכזי של <strong>{ATTRACTION.cityHe}</strong> ב<strong>{ATTRACTION.regionHe}</strong>, <strong>{ATTRACTION.countryHe}</strong>. השם הקצר <strong>{ATTRACTION.shortNameHe}</strong> והשם הרשמי מתארים את אותו מקום: רחובות שוק פתוחים בלב ירושלים, שמשמשים נקודת מפגש למזון, מסחר ותרבות מקומית.</p>
        <p class="lede">שוק מחנה יהודה יושב בין רחוב אגריפס לרחוב יפו, בלב מרקם עירוני ותיק. ביום הוא מזוהה עם תוצרת טרייה, תבלינים, מאפים ומצרכים; אחרי סגירת חלק מן הדוכנים נחשפים תריסים מצוירים והאזור מקבל אופי אחר. המדריך הזה מתמקד בעובדות, בהקשר ובהכנה מעשית לביקור — ללא דירוג עסקים וללא תוכן ממומן.</p>
        <div class="facts">
          <div><span>כתובת</span><strong>רחוב אגריפס 90, ירושלים</strong></div>
          <div><span>אופי המקום</span><strong>שוק עירוני היסטורי ופתוח לציבור</strong></div>
          <div><span>דוגמת משך, לפי הקצב</span><strong>כשעה וחצי עד שלוש שעות</strong></div>
          <div><span>שפה וסביבה</span><strong>עברית; מרכז עיר צפוף והליכתי</strong></div>
          <div><span>קואורדינטות</span><strong>{ATTRACTION.latitude}, {ATTRACTION.longitude}</strong></div>
          <div><span>דירוג מבקרים</span><strong>{ratingLabel} · {ratingCountLabel} ביקורות ב־{ATTRACTION.ratingSourceNote}</strong></div>
          <div><span>כתובת לניווט באנגלית</span><strong>{ATTRACTION.streetAddressEn}, {ATTRACTION.cityEn}, {ATTRACTION.countryEn}</strong></div>
        </div>
        <p class="notice">שעות של דוכנים ועסקים בודדים אינן אחידות ועשויות להשתנות לפני שבת, בערבי חג ובחגים. לפני נסיעה מיוחדת מומלץ לאמת מידע תפעולי בערוץ רשמי או במפת תחבורה עדכנית.</p>
      </div>
    </div>
  </section>

  <section class="history section" id="history">
    <div class="container">
      <p class="eyebrow">היסטוריה והקשר</p>
      <h2 class="section-title">ממגרש פתוח למוסד ירושלמי<span class="section-en">History &amp; Significance of {ATTRACTION.nameEn}</span></h2>
      <div class="history-layout">
        <figure class="history-photo">
          <img src="/images/agripas.jpg" alt="רחוב אגריפס בירושלים ליד שוק מחנה יהודה, עם חזיתות אבן ואמנות רחוב" loading="lazy" />
          <figcaption>רחוב אגריפס ליד השוק · Laura Siegal · פורסם 23.11.2019 · <a href="#photo-credits">מקור ורישיון</a></figcaption>
        </figure>
        <div class="timeline">
          <article><span>סוף המאה ה־19</span><h3>השוק נוצר לצד השכונות החדשות</h3><p>כשהעיר התרחבה מערבה מחוץ לחומות, נוצרה בשטח פתוח סמוך לשכונת בית יעקב נקודת מסחר. פלאחים וסוחרים ערבים הביאו תוצרת, ותושבי השכונות היהודיות החדשות קנו בה מזון יום־יומי. השוק נקרא תחילה על שם בית יעקב.</p></article>
          <article><span>תקופת המנדט</span><h3>מהתארגנות ספונטנית לשוק מוסדר</h3><p>לפי סקירת ההיסטוריה באתר השוק, רשויות המנדט יזמו תכנון מסודר, אך תכנית אשבי לא בוצעה בשל מגבלות תקציב. חנויות קבע ויוזמות של סוחרים התפתחו בהמשך; אין לייחס את כולן לביצוע התכנית המקורית.</p></article>
          <article><span>1931</span><h3>התרחבות וסיפורי קהילות</h3><p>באותה תקופה נוספו אזורים פנימיים, ובהם מתחם שזוהה עם סוחרים מן הקהילה העיראקית. המבנה הפנימי של השוק משקף עד היום שכבות שונות של מסחר, הגירה והתבססות קהילתית בעיר.</p></article>
          <article><span>המאה ה־21</span><h3>שוק יום, תרבות ערב</h3><p>שדרוגי תשתית ויוזמות עירוניות ופרטיות חיזקו את פעילות המזון והבילוי. לאחר הסגירה של דוכנים רבים, תריסי המתכת המצוירים הופכים את המעברים למעין גלריית רחוב פתוחה — שינוי שממחיש כיצד השוק ממשיך להתאים את עצמו לעיר.</p></article>
          <article><span>אמנות רחוב</span><h3>התריסים המצוירים וגלריית הרחוב</h3><p>בתריסי השוק מופיעות עבודות אמנות רחוב; אין כאן רשימה מאומתת של ציורים הקיימים כיום. העבודה חיברה בין שיפוץ פיזי לבין זהות ויזואלית של השוק, והפכה את המקום לנושא בצילום עירוני ובסיורי תרבות — בלי לגעת באופיו כמרחב מסחר יומיומי.</p></article>
        </div>
      </div>
      <div class="story card">
        <p class="eyebrow">מקור השם</p>
        <h3>מחנה יהודה — השם והשכונה שמאחוריו</h3>
        <p>השוק נושא את שמה של שכונת מחנה יהודה, שהוקמה בסוף המאה ה־19 ממערב לחומות העיר העתיקה. השכונה והשוק גדלו יחד: מה שהחל כנקודת מפגש בין חקלאים מהסביבה לבין תושבי השכונות היהודיות החדשות, הפך בהדרגה למתחם מסחרי עירוני שלם. לכן השם אינו רק תווית — הוא מצביע על הקשר שבין התפתחות העיר החדשה של ירושלים לבין השוק עצמו.</p>
      </div>
      <div class="story card">
        <p class="eyebrow">למה המידע הזה חשוב</p>
        <h3>לא צריך להמציא אגדה: הסיפור נמצא בשכבות של השוק</h3>
        <p>החשיבות של מחנה יהודה אינה נשענת על מיתוס יחיד, אלא על תהליך עירוני: מפגש בין חקלאים וסוחרים לבין שכונות חדשות, מעבר מכלכלה של שוליים אל מרכז מסחרי, ובהמשך חיבור בין מסורת קולינרית לתרבות רחוב עכשווית. אפשר לקרוא את הרקע בסקירת ההיסטוריה המקושרת של אתר השוק ולהבחין בינו לבין מידע תפעולי עכשווי.</p>
      </div>
    </div>
  </section>

  <section class="section tastes" id="food">
    <div class="container section-grid">
      <div>
        <p class="eyebrow">מה אוכלים</p>
        <h2 class="section-title">טעמים, לא דירוגים</h2>
        <p class="lede">במקום להמליץ על עסק מסוים, עדיף להגיע עם מילון טעמים. המבחר משתנה בין דוכנים ובין שעות היום.</p>
      </div>
      <div class="food-grid">
