---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const heroImage = Astro.site ? new URL('/og-card.png', Astro.site).href : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'שוק מחנה יהודה',
  alternateName: 'Mahane Yehuda Market',
  description: 'שוק עירוני היסטורי במרכז ירושלים, המשלב מסחר במזון, רחובות שוק, תרבות מקומית וחיי ערב.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'רחוב אגריפס 90',
    addressLocality: 'ירושלים',
    addressCountry: 'IL'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.785556,
    longitude: 35.212222
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday','Monday','Tuesday','Wednesday','Thursday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '08:00', closes: '15:00' }
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.7',
    ratingCount: 78,
    bestRating: '5'
  },
  isAccessibleForFree: true,
  priceRange: 'כניסה חופשית',
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(heroImage ? { image: heroImage } : {})
};

const faqs = [
  ['האם הכניסה לשוק מחנה יהודה כרוכה בתשלום?', 'לא. הכניסה לרחובות השוק חופשית. מזון, קניות, סיורים או פעילויות פרטיות הם בתשלום נפרד ובהתאם לבחירה.'],
  ['מתי כדאי להגיע?', 'לביקור נוח יחסית כדאי לבחור ביום חול בשעות הבוקר המאוחרות או בצהריים. שישי בבוקר מעניק אווירת קניות חזקה לפני שבת, אך גם צפוף יותר. שעות הפעילות עשויות להשתנות בערבי חג ובחגים.'],
  ['האם השוק פתוח בשבת?', 'דוכני השוק המסורתיים סגורים בשבת. פעילות ערב של עסקים פרטיים בסביבה משתנה ממקום למקום ואינה מעידה על פתיחת השוק כולו.'],
  ['יש שירותים ציבוריים?', 'כן. במתחם מוכרים שלושה מוקדים: באזור רחוב עץ חיים ליד הכניסה מאגריפס, באזור רחוב השזיף פינת מחנה יהודה, וברחוב התפוח פינת מחנה יהודה. חלוקת תאי נשים וגברים אינה זהה בכל מוקד, ולכן יש להיעזר בשילוט במקום.'],
  ['האם השוק נגיש לכיסאות גלגלים ולעגלות?', 'הצירים הראשיים בדרך כלל מישוריים ונגישים יחסית, אך חלק מהמעברים צרים, עמוסים או בעלי ספים. נגישות בתוך חנויות ושירותים פרטניים משתנה; מומלץ להגיע בשעות פחות עמוסות.'],
  ['איך מגיעים מנתב״ג?', 'אפשר להגיע ברכבת לירושלים–יצחק נבון, ומשם להמשיך ברכבת הקלה לכיוון מרכז העיר ולרדת בתחנת מחנה יהודה. קיימת גם אפשרות למונית מורשית מהשדה.'],
  ['אפשר להגיע ברכב פרטי?', 'כן, אך החניה במרכז העיר מוגבלת וברובה בתשלום, והרחובות סביב השוק עמוסים בשעות השיא. תחבורה ציבורית או חנה־וסע בשילוב הרכבת הקלה הם לרוב פתרון פשוט יותר.'],
  ['האם כל האוכל בשוק כשר?', 'לא ניתן להניח שכל עסק פועל תחת אותה השגחה. מי שנדרש לכשרות מסוימת צריך לבדוק תעודה תקפה והיקף השגחה בכל נקודת מכירה בנפרד.']
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q,a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---
<BaseLayout title="שוק מחנה יהודה — מדריך מבקרים עצמאי" description="מדריך עצמאי וללא מטרות רווח לשוק מחנה יהודה בירושלים: היסטוריה, שעות, הגעה מנתב״ג, תחבורה ציבורית, שירותים, נגישות, אוכל, חניה ושאלות נפוצות.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(attractionSchema)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>

  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src="https://upload.wikimedia.org/wikipedia/commons/5/5b/Mahane_Yehuda_%28I%29_%2845298221191%29.jpg" alt="" fetchpriority="high" />
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="market-stamp">ירושלים · מרכז העיר</span>
        <p class="eyebrow light">שוק, שכונה וסיפור עירוני</p>
        <h1>שוק<br />מחנה יהודה</h1>
        <p class="hero-lede">יותר ממקום לקנות בו ירקות: מרחב ירושלמי שנולד מן היציאה מחוץ לחומות, התמסד כשוק עירוני, והפך למפגש בין מזון, מסחר, זיכרון, אמנות רחוב וחיי ערב.</p>
        <div class="hero-actions">
          <a class="primary" href="#visit">לתכנון הביקור</a>
          <a class="secondary" href="#history">לסיפור ההיסטורי</a>
        </div>
      </div>
      <aside class="quick" aria-label="מידע מהיר">
        <div><strong>חינם</strong><span>כניסה לשוק</span></div>
        <div><strong>א׳–ה׳</strong><span>08:00–19:00</span></div>
        <div><strong>ו׳</strong><span>08:00–15:00</span></div>
        <div><strong>שבת</strong><span>השוק סגור</span></div>
      </aside>
    </div>
    <p class="photo-credit">צילום: Emilio García · Wikimedia Commons · CC BY-SA 2.0</p>
  </section>

  <section class="section intro" id="overview">
    <div class="container section-grid">
      <div>
        <p class="eyebrow">במבט אחד</p>
        <h2 class="section-title">השוק שמספר את ירושלים דרך הרחוב</h2>
      </div>
      <div>
        <p class="lede">שוק מחנה יהודה יושב בין רחוב אגריפס לרחוב יפו, בלב מרקם עירוני ותיק. ביום הוא מזוהה עם תוצרת טרייה, תבלינים, מאפים ומצרכים; אחרי סגירת חלק מן הדוכנים נחשפים תריסים מצוירים והאזור מקבל אופי אחר. המדריך הזה מתמקד בעובדות, בהקשר ובהכנה מעשית לביקור — ללא דירוג עסקים וללא תוכן ממומן.</p>
        <div class="facts">
          <div><span>כתובת</span><strong>רחוב אגריפס 90, ירושלים</strong></div>
          <div><span>אופי המקום</span><strong>שוק עירוני היסטורי ופתוח לציבור</strong></div>
          <div><span>משך מומלץ</span><strong>כשעה וחצי עד שלוש שעות</strong></div>
          <div><span>שפה וסביבה</span><strong>עברית; מרכז עיר צפוף והליכתי</strong></div>
        </div>
        <p class="notice">שעות של דוכנים ועסקים בודדים אינן אחידות ועשויות להשתנות לפני שבת, בערבי חג ובחגים. לפני נסיעה מיוחדת מומלץ לאמת מידע תפעולי בערוץ רשמי או במפת תחבורה עדכנית.</p>
      </div>
    </div>
  </section>

  <section class="history section" id="history">
    <div class="container">
      <p class="eyebrow">היסטוריה והקשר</p>
      <h2 class="section-title">ממגרש פתוח למוסד ירושלמי</h2>
      <div class="history-layout">
        <figure class="history-photo">
          <img src="https://images.unsplash.com/photo-1574513828624-af4be898b59e?auto=format&fit=crop&fm=jpg&q=82&w=1800" alt="רחוב אגריפס בירושלים ליד שוק מחנה יהודה, עם חזיתות אבן ואמנות רחוב" loading="lazy" />
          <figcaption>רחוב אגריפס ליד השוק · צילום: Laura Siegal / Unsplash</figcaption>
        </figure>
        <div class="timeline">
          <article><span>סוף המאה ה־19</span><h3>השוק נוצר לצד השכונות החדשות</h3><p>כשהעיר התרחבה מערבה מחוץ לחומות, נוצרה בשטח פתוח סמוך לשכונת בית יעקב נקודת מסחר. פלאחים וסוחרים ערבים הביאו תוצרת, ותושבי השכונות היהודיות החדשות קנו בה מזון יום־יומי. השוק נקרא תחילה על שם בית יעקב.</p></article>
          <article><span>תקופת המנדט</span><h3>מהתארגנות ספונטנית לשוק מוסדר</h3><p>בסוף שנות העשרים של המאה ה־20 החלו רשויות המנדט להסדיר את המרחב, להחליף חלק מן המבנים המאולתרים בדוכנים קבועים ולשפר קירוי ותשתיות. כך קיבל השוק צורה עירונית מוכרת יותר.</p></article>
          <article><span>1931</span><h3>התרחבות וסיפורי קהילות</h3><p>באותה תקופה נוספו אזורים פנימיים, ובהם מתחם שזוהה עם סוחרים מן הקהילה העיראקית. המבנה הפנימי של השוק משקף עד היום שכבות שונות של מסחר, הגירה והתבססות קהילתית בעיר.</p></article>
          <article><span>המאה ה־21</span><h3>שוק יום, תרבות ערב</h3><p>שדרוגי תשתית ויוזמות עירוניות ופרטיות חיזקו את פעילות המזון והבילוי. לאחר הסגירה של דוכנים רבים, תריסי המתכת המצוירים הופכים את המעברים למעין גלריית רחוב פתוחה — שינוי שממחיש כיצד השוק ממשיך להתאים את עצמו לעיר.</p></article>
        </div>
      </div>
      <div class="story card">
        <p class="eyebrow">סיפור מקומי מתועד</p>
        <h3>לא צריך להמציא אגדה: הסיפור של השוק נמצא בשכבות שלו</h3>
        <p>החשיבות של מחנה יהודה אינה נשענת על מיתוס יחיד, אלא על תהליך עירוני: מפגש בין חקלאים וסוחרים לבין שכונות חדשות, מעבר מכלכלה של שוליים אל מרכז מסחרי, ובהמשך חיבור בין מסורת קולינרית לתרבות רחוב עכשווית. עבור אתר מידע מקצועי, הסיפור הזה מעניין יותר — ובעיקר ניתן לבדיקה.</p>
      </div>
    </div>
  </section>

  <section class="section tastes" id="food">
    <div class="container section-grid">
      <div>
        <p class="eyebrow">מה אוכלים</p>
        <h2 class="section-title">טעמים, לא דירוגים</h2>
        <p class="lede">במקום להמליץ על עסק מסוים, עדיף להגיע עם מילון טעמים. המבחר משתנה בין דוכנים ובין שעות היום.</p>
      </div>
      <div class="food-grid">
        <article class="food-card"><span>01</span><h3>תוצרת ותבלינים</h3><p>פירות וירקות, עשבי תיבול, תבלינים, אגוזים, פירות יבשים, זיתים וקטניות — הליבה המסורתית של השוק.</p></article>
        <article class="food-card"><span>02</span><h3>מאפים ואוכל רחוב</h3><p>בורקס, פיתות, פלאפל, חומוס, שווארמה ומנות מבוססות קובה מופיעים בצורות שונות. ההיצע משתנה.</p></article>
        <article class="food-card"><span>03</span><h3>מתוק ומשקאות</h3><p>חלבה, בקלאווה, כנאפה, ממתקים, קפה ומיצי פירות הם חלק מן הפסיפס הקולינרי.</p></article>
        <article class="food-card"><span>04</span><h3>כשרות ורגישויות</h3><p>ההשגחה אינה אחידה. יש לבדוק תעודת כשרות, אלרגנים ואופן הכנה מול נקודת המכירה לפני הזמנה.</p></article>
      </div>
    </div>
    <div class="container photo-strip">
      <figure><img src="https://images.unsplash.com/photo-1645028846276-397e358c463c?auto=format&fit=crop&fm=jpg&q=80&w=1500" alt="מבחר אגוזים בשוק מחנה יהודה" loading="lazy" /><figcaption>צילום: Ilanit Ohana / Unsplash</figcaption></figure>
      <figure><img src="https://images.unsplash.com/photo-1645028846507-5c7ff1ba1266?auto=format&fit=crop&fm=jpg&q=80&w=1500" alt="רימונים טריים בשוק מחנה יהודה" loading="lazy" /><figcaption>צילום: Ilanit Ohana / Unsplash</figcaption></figure>
      <figure><img src="https://images.unsplash.com/photo-1645028846076-0cf7fc06664a?auto=format&fit=crop&fm=jpg&q=80&w=1500" alt="ממתקים צבעוניים בשוק מחנה יהודה" loading="lazy" /><figcaption>צילום: Ilanit Ohana / Unsplash</figcaption></figure>
    </div>
  </section>

  <section class="section visit" id="visit">
    <div class="container">
      <p class="eyebrow">תכנון ביקור</p>
      <h2 class="section-title">להגיע מוכנים, להשאיר מקום לספונטניות</h2>
      <div class="visit-grid">
        <article class="card big"><h3>הזמן הטוב ביותר</h3><p>יום חול בשעות הבוקר המאוחרות עד אחר הצהריים מתאים למי שרוצה לראות את השוק פעיל בלי העומס המרבי של יום שישי. שישי בבוקר הוא חוויה ירושלמית אינטנסיבית לפני שבת, אך צפוף ורועש יותר. בערב משתנה האופי: חלק מדוכני היום נסגרים, ואמנות התריסים והפעילות הלילית בולטות יותר.</p><p class="mini">שהייה מומלצת: כ־1.5–3 שעות לביקור נינוח; פחות מכך אם המטרה היא רק מעבר והתרשמות.</p></article>
        <article class="card"><h3>כרטיסים ועלויות</h3><p>הכניסה לשוק חופשית ואין שער כניסה. קניות, אוכל, סדנאות או סיורים פרטיים הם הוצאות נפרדות. המחירים אינם אחידים, ולכן אין באתר טווח מחיר מסחרי.</p></article>
        <article class="card"><h3>לבוש והתנהלות</h3><p>נעליים נוחות עדיפות; המעברים עלולים להיות צפופים ולעיתים רטובים. בקיץ מומלץ להצטייד במים ובהגנה מהשמש לפני ההגעה למרכז העיר.</p></article>
        <article class="card"><h3>שישי ושבת</h3><p>לפני שבת הפעילות נוטה להסתיים מוקדם יותר. בשבת השוק המסורתי סגור. בערבי חג ובחגים ייתכנו שינויים נוספים, ולכן מומלץ לבדוק מידע סמוך לביקור.</p></article>
      </div>
    </div>
  </section>

  <section class="section transport" id="transport">
    <div class="container section-grid">
      <div>
        <p class="eyebrow">הגעה ותחבורה</p>
        <h2 class="section-title">מרכבת בנתב״ג עד סמטת השוק</h2>
        <p class="lede">המרכז הירושלמי צפוף, ולכן תחבורה ציבורית בדרך כלל נוחה יותר מרכב פרטי. קווים ומסלולים משתנים; במקום להקפיא מספרי קווים באתר, עדיף לבדוק מתכנן נסיעה עדכני ביום ההגעה.</p>
      </div>
      <div class="routes">
        <article><div class="route-icon">✈</div><div><h3>מנמל התעופה בן־גוריון</h3><p>רכבת ישראל מחברת את נתב״ג לתחנת ירושלים–יצחק נבון. מהתחנה ממשיכים לרכבת הקלה לכיוון מרכז העיר ויורדים בתחנת מחנה יהודה, סמוך לרחוב יפו ולכניסות הצפוניות לשוק. מוניות מורשות זמינות גם בנמל התעופה.</p></div></article>
        <article><div class="route-icon">🚊</div><div><h3>רכבת קלה</h3><p>תחנת “מחנה יהודה” של הקו האדום נמצאת על רחוב יפו, במרחק קצר מן השוק. זהו פתרון נוח למגיעים מאזור התחנה המרכזית, מרכז העיר וצירים נוספים לאורך הקו.</p></div></article>
        <article><div class="route-icon">🚌</div><div><h3>אוטובוסים עירוניים</h3><p>רחובות יפו ואגריפס וסביבתם משורתים בקווי אוטובוס רבים. בשל שינויים תפעוליים ועבודות תשתית, יש לבדוק בזמן אמת באפליקציית תחבורה או במערכת המידע הארצית.</p></div></article>
        <article><div class="route-icon">🚕</div><div><h3>מונית</h3><p>בקשו הורדה בשולי המתחם, ברחוב אגריפס או ברחוב יפו לפי מצב התנועה. סמטאות השוק עצמן מיועדות בעיקר להולכי רגל ואינן מקום מתאים להורדה פנימית.</p></div></article>
        <article><div class="route-icon">🚗</div><div><h3>רכב פרטי וחניה</h3><p>החניה במרכז העיר מוגבלת וברובה בתשלום, והעומס עולה בשעות פעילות השוק. מומלץ לשקול חניון ציבורי בתשלום מחוץ למרקם הצפוף או חנה־וסע בשילוב רכבת קלה. יש לפעול לפי תמרור ותעריף עדכניים.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section map-section" id="map">
